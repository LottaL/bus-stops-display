# Bus Stops Display - Environment Variables
# Copy this file to .env.local and fill in your values

# Digitransit API Key (REQUIRED since 31.1.2024)
# How to get your API key:
# 1. Register at https://portal-api.digitransit.fi/
# 2. Subscribe to the desired API products (free tier available)
# 3. Copy your API key from the Profile tab
# 4. Paste it below
VITE_DIGITRANSIT_API_KEY=

# Digitransit Routing API Configuration (v2 - current API, deprecated Timetables v1)
# Available routers: hsl (Helsinki), waltti (Other Finnish cities), finland (nationwide)
VITE_DIGITRANSIT_ROUTER=hsl
VITE_DIGITRANSIT_API_URL=https://api.digitransit.fi/routing/v2/hsl/gtfs/v1

# Weather API (currently no key needed)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# App Configuration
VITE_DEFAULT_LAT=60.1699
VITE_DEFAULT_LON=24.9384
VITE_DEFAULT_ZOOM=15

# API Refresh Intervals (in milliseconds)
VITE_BUS_REFRESH_INTERVAL=30000
VITE_WEATHER_REFRESH_INTERVAL=600000

# Cache Settings (in seconds)
VITE_CACHE_MAX_AGE_DIGITRANSIT=300
VITE_CACHE_MAX_AGE_WEATHER=600
