# Bus Stops Display - Environment Variables
# Copy this file to .env.local and fill in your values

VITE_DIGITRANSIT_API_PROXY_URL=

# Weather API (currently no key needed)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# App Configuration
VITE_DEFAULT_LAT=60.1699
VITE_DEFAULT_LON=24.9384
VITE_DEFAULT_ZOOM=15

# API Refresh Intervals (in milliseconds)
VITE_BUS_REFRESH_INTERVAL=60000
VITE_WEATHER_REFRESH_INTERVAL=3600000

# Cache Settings (in seconds)
VITE_CACHE_MAX_AGE_DIGITRANSIT=600
VITE_CACHE_MAX_AGE_WEATHER=3600
